{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/ga4gh/schema/cat-vrs/v1/json/CategoricalCnv",
   "title": "CategoricalCnv",
   "type": "object",
   "maturity": "draft",
   "description": "A representation of the constraints for matching knowledge about CNVs.",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/cat-vrs/v1/json/CategoricalVariant"
      },
      {
         "properties": {
            "constraints": {
               "minItems": 2,
               "maxItems": 2,
               "description": "The constraints array must contain exactly two items: a DefiningLocationConstraint and either a CopyChangeConstraint or CopyCountConstraint.",
               "allOf": [
                  {
                     "contains": {
                        "allOf": [
                           {
                              "$ref": "/ga4gh/schema/cat-vrs/v1/json/DefiningLocationConstraint"
                           },
                           {
                              "properties": {
                                 "relations": {
                                    "contains": {
                                       "properties": {
                                          "primaryCoding": {
                                             "code": {
                                                "const": "liftover_to"
                                             },
                                             "system": {
                                                "const": "ga4gh-gks-term:allele-relation"
                                             }
                                          }
                                       }
                                    }
                                 }
                              }
                           }
                        ]
                     }
                  },
                  {
                     "contains": {
                        "oneOf": [
                           {
                              "$ref": "/ga4gh/schema/cat-vrs/v1/json/CopyCountConstraint"
                           },
                           {
                              "$ref": "/ga4gh/schema/cat-vrs/v1/json/CopyChangeConstraint"
                           }
                        ]
                     }
                  }
               ]
            }
         }
      }
   ]
}
