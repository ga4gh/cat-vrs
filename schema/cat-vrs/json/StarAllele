{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/ga4gh/schema/cat-vrs/1.1.0-ballot.2026-07.1/json/StarAllele",
   "title": "StarAllele",
   "type": "object",
   "maturity": "draft",
   "description": "A Composite Categorical Variant that joins one or more present Categorical Variant Criteria with the AND operator and a cis phase relation, representing a haplotype of a single gene defined by those variants.",
   "allOf": [
      {
         "$ref": "/ga4gh/schema/cat-vrs/1.1.0-ballot.2026-07.1/json/CompositeCategoricalVariant"
      },
      {
         "properties": {
            "operator": {
               "const": "AND"
            },
            "phaseRelation": {
               "const": "cis"
            },
            "elements": {
               "description": "The elements array must contain one or more present Categorical Variant Criteria, each defining a variant of the haplotype.",
               "minItems": 1,
               "items": {
                  "allOf": [
                     {
                        "$ref": "/ga4gh/schema/cat-vrs/1.1.0-ballot.2026-07.1/json/CategoricalVariantCriterion"
                     },
                     {
                        "properties": {
                           "presence": {
                              "const": "present"
                           }
                        }
                     }
                  ]
               }
            }
         },
         "required": [
            "phaseRelation"
         ]
      }
   ]
}
