{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/ga4gh/schema/cat-vrs/v1/json/CompositeCategoricalVariant",
   "title": "CompositeCategoricalVariant",
   "type": "object",
   "maturity": "draft",
   "description": "A logical expression that combines one or more Categorical Variant Criteria, or nested Composite Categorical Variants, using a boolean operator.",
   "properties": {
      "id": {
         "type": "string",
         "description": "The 'logical' identifier of the Entity in the system of record, e.g. a UUID.  This 'id' is unique within a given system, but may or may not be globally unique outside the system. It is used within a system to reference an object from another."
      },
      "type": {
         "type": "string",
         "description": "MUST be \"CompositeCategoricalVariant\"",
         "const": "CompositeCategoricalVariant",
         "default": "CompositeCategoricalVariant"
      },
      "name": {
         "type": "string",
         "description": "A primary name for the entity."
      },
      "description": {
         "type": "string",
         "description": "A free-text description of the Entity."
      },
      "aliases": {
         "type": "array",
         "ordered": false,
         "items": {
            "type": "string"
         },
         "description": "Alternative name(s) for the Entity."
      },
      "extensions": {
         "type": "array",
         "ordered": false,
         "items": {
            "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/Extension"
         },
         "description": "A list of extensions to the Entity, that allow for capture of information not directly supported by elements defined in the model."
      },
      "elements": {
         "type": "array",
         "description": "The Categorical Variant Criterion and/or nested Composite Categorical Variants joined by `operator`.",
         "items": {
            "oneOf": [
               {
                  "$ref": "/ga4gh/schema/cat-vrs/v1/json/CategoricalVariantCriterion"
               },
               {
                  "$ref": "/ga4gh/schema/cat-vrs/v1/json/CompositeCategoricalVariant"
               }
            ]
         },
         "minItems": 1,
         "ordered": false
      },
      "operator": {
         "type": "string",
         "description": "Operator used to join the included elements.",
         "oneOf": [
            {
               "const": "AND",
               "description": "All elements must be satisfied."
            },
            {
               "const": "OR",
               "description": "At least one element must be satisfied."
            }
         ]
      },
      "phaseRelation": {
         "type": "string",
         "description": "The phase relationship asserted to hold among the present elements of this composite. Only meaningful when `operator` is `AND`, since phase describes a relationship among co-occurring (present) elements.",
         "oneOf": [
            {
               "const": "unknown",
               "description": "Phase among the elements is not asserted."
            },
            {
               "const": "cis",
               "description": "All elements are asserted to occur on the same molecule. Well-defined for any number of elements."
            },
            {
               "const": "trans",
               "description": "The elements are asserted to occur on different molecules. Only well-defined for exactly two elements."
            }
         ]
      },
      "mappings": {
         "type": "array",
         "ordered": false,
         "items": {
            "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/ConceptMapping"
         },
         "description": "A list of mappings to concepts in terminologies or code systems. Each mapping should include a coding and a relation."
      }
   },
   "required": [
      "elements",
      "name",
      "operator",
      "type"
   ],
   "additionalProperties": false
}
