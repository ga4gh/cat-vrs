{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/ga4gh/schema/cat-vrs/v1/json/CategoricalVariantCriterion",
   "title": "CategoricalVariantCriterion",
   "type": "object",
   "maturity": "draft",
   "description": "An assertion that a Categorical Variant is required to be present or absent.",
   "properties": {
      "id": {
         "type": "string",
         "description": "The 'logical' identifier of the data element in the system of record, e.g. a UUID.  This 'id' is unique within a given system, but may or may not be globally unique outside the system. It is used within a system to reference an object from another."
      },
      "extensions": {
         "type": "array",
         "ordered": false,
         "items": {
            "$ref": "/ga4gh/schema/gkm-core/1.3.0/json/Extension"
         },
         "description": "A list of extensions to the Entity, that allow for capture of information not directly supported by elements defined in the model."
      },
      "type": {
         "type": "string",
         "const": "CategoricalVariantCriterion",
         "default": "CategoricalVariantCriterion",
         "description": "MUST be \"CategoricalVariantCriterion\""
      },
      "subject": {
         "$ref": "/ga4gh/schema/cat-vrs/v1/json/CategoricalVariant",
         "description": "The subject Categorical Variant of this criterion."
      },
      "presence": {
         "type": "string",
         "description": "Whether the subject Categorical Variant is asserted to be present or absent.",
         "oneOf": [
            {
               "const": "present",
               "description": "The subject Categorical Variant is present."
            },
            {
               "const": "absent",
               "description": "The subject Categorical Variant is absent."
            }
         ]
      }
   },
   "required": [
      "presence",
      "subject",
      "type"
   ],
   "additionalProperties": false
}
